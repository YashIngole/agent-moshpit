{
  "name": "agent-moshpit",
  "private": true,
  "version": "0.5.0",
  "description": "A small desktop office for coding agents: Claude Code, Codex and the rest, each in a terminal of its own",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:tools": "node --test tools/*.test.mjs",
    "test:ui": "vite build && node tools/e2e/ui-demo.mjs",
    "test:launch": "vite build && node tools/e2e/launch-settings.mjs",
    "test:app": "node tools/e2e/terminals.mjs && node tools/e2e/reliability.mjs",
    "test:mcp": "node tools/e2e/mcp.mjs",
    "build:site": "vite build --base ./ --outDir site/demo --emptyOutDir",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.1",
    "playwright-core": "^1.63.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}

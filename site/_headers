# Headers for every file of the site (Cloudflare reads this file; it is not served).
# The one thing from outside is Cloudflare's own Web Analytics, which counts visits
# without cookies; the browser is told that nothing else may load.
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'none'; object-src 'none'
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/demo/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The app's own window, shown inside the page, is not a page of its own to count.
# "no-transform" keeps Cloudflare from adding its analytics script to it.
/demo/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/demo/index.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform

# The install scripts are read as text, by a shell and by a person.
/install.sh
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: noindex

/install.ps1
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: noindex

# Not pages for a search engine to list: the app's own window with its demo data, and
# the scripts above. A crawler may still fetch the window to draw the home page.
/demo/*
  X-Robots-Tag: noindex

/404.html
  X-Robots-Tag: noindex

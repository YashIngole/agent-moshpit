# Cloudflare Pages: headers for every file of the site.
# The page loads nothing from anyone else, and says so to the browser.
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self'; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'none'; object-src 'none'
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/demo/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The pages themselves are sent as they are written. Without "no-transform" Cloudflare
# adds its Web Analytics script to them on the way out, and this site has no trackers.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/index.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/demo/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/demo/index.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform

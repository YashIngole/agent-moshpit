// agentmoshpit.com on Cloudflare: the files in site/, served as they are.
//
//   npm run build:site
//   npx wrangler deploy --config tools/cloudflare/site.jsonc
//
// No code runs for a request: these are static files, with the headers in
// site/_headers and the redirects in site/_redirects.
{
  "name": "agentmoshpit",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../../site",
    // An address that is not there gets site/404.html, with the status 404.
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "agentmoshpit.com", "custom_domain": true }]
}

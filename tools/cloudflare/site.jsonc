// agentmoshpit.com on Cloudflare: the files in site/, served as they are, with the
// headers in site/_headers and the redirects in site/_redirects.
//
//   npm run build:site
//   npx wrangler deploy --config tools/cloudflare/site.jsonc
//
// Code runs for three kinds of address only (site.js): /get/<installer>, which is counted
// and sent on to that file of the newest release, and the two install scripts, which are
// counted and then served like any other file. The counts are kept in a D1 database, one
// number for each day, file, way it was asked for and country (downloads.sql), and read
// with `node tools/download-counts.mjs`.
{
  "name": "agentmoshpit",
  "main": "site.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../../site",
    "binding": "ASSETS",
    // An address that is not there gets site/404.html, with the status 404.
    "not_found_handling": "404-page",
    "run_worker_first": ["/get/*", "/install.sh", "/install.ps1"]
  },
  // Not a secret: it names the database, and opens nothing without the account.
  "d1_databases": [{ "binding": "DB", "database_name": "agentmoshpit-downloads", "database_id": "000fa660-8115-4807-acc5-88d28351c8b0" }],
  "routes": [{ "pattern": "agentmoshpit.com", "custom_domain": true }]
}
